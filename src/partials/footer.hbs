<div class='js-modal-call modal-call'>
  <div class='modal__body'>
    <div class='modal__content'>
      <a href='' class='modal__close'>
        <svg
          width='16'
          height='16'
          viewBox='0 0 16 16'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
        >
          <g clip-path='url(#clip0_566_3648)'>
            <path d='M-0.485352 -0.485291L35.5771 35.5772' stroke='#4C4657' stroke-width='1.5' />
            <path d='M16.4854 -0.485291L-19.5771 35.5772' stroke='#4C4657' stroke-width='1.5' />
          </g>
          <defs>
            <clipPath id='clip0_566_3648'>
              <rect width='16.0001' height='16' fill='white' />
            </clipPath>
          </defs>
        </svg>
      </a>
      <div class='modal__wrapper'>
        <h2 class='modal__title'>Заказать звонок</h2>
        <div class='modal__inputs'>
          <div class='modal__input'>
            <label class='modal__label' for=''>Имя</label>
            <input
              name='user_name'
              class='modal__name'
              type='text'
              data-type='text'
              placeholder='Имя'
            />

          </div>
          <div class='modal__input wrapper__phone'>
            <label class='modal__label' for=''>Телефон</label>
            <input
              data-mask='phone'
              name='user_phone'
              class='modal__tel'
              data-type='phone'
              type='text'
              id='modal-phone'
              inputmode='text'
              placeholder='+7 999 111 22 33'
            />

          </div>
        </div>
        <div class='form-check'>
          <input
            class='form-check-input'
            id='flexCheckChecked'
            type='checkbox'
            required='required'
          />
          <label class='form-check-label' for='flexCheckChecked'>
            <span class='custom-checkbox-icon'></span>
            <p>Я&nbsp;даю согласие на
              <a class='' href='/policy.pdf' target='_blank' rel='noopener noreferrer'>обработку
                моих персональных данных</a>
              и&nbsp;ознакомлен (-а)
              <a href='/policy.pdf' target='_blank'>c&nbsp;политикой конфиденциальности</a></p>
          </label>
        </div>
        <button class='btn btn-reset btn-accent modal__link' disabled href=''>Забронировать</button>
      </div>
    </div>
  </div>
</div>

